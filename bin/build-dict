#!/usr/bin/env bash
# yaskkserv2 のシステム辞書 (dictionary.yaskkserv2) を上流に追従して再構築する。
#
# 上流の SKK 辞書群を取得 → 一時ファイルにビルド → 原子的差し替え → 変化時のみ
# yaskkserv2 サービスを再起動する。launchd から 1 時間ごとに呼ばれ、上流の確認は
# $CHECK_STAMP を見て 1 日 1 回 ($CHECK_INTERVAL_SEC ごと) に間引く。
#
# 定時 (StartCalendarInterval) にしないのは、毎晩電源を切る Mac では定時の起動が
# 一度も来ないため (スリープ中に逃した分は起床時に発火するが、電源断の分は発火しない)。
#
# 再ビルドは「上流辞書データが変わったとき」または「ビルドレシピ (この build-dict と
# normalize-jisyo、make-shikakugoma) が変わったとき」に走る。後者は $RECIPE_STAMP の
# 指紋比較で検知するので、レシピを編集すれば次回の日次実行で自動的に反映される
# (--force 不要)。
#
# 再構築したら、同じ内容を SKK-JISYO 形式 (UTF-8) で書き出して macSKK の辞書フォルダへコピーする
# (macSKK は yaskkserv2 の辞書形式を読めず、辞書をメモリに持って引くため)。
#
# AquaSKK の HTTP 辞書自動更新 (SKKHttpDictionaryLoader) を置き換えるもの。
# 個人学習辞書 (delphinus/skk-jisyo) とは別系統 — こちらは公開システム辞書専用。
#
# 使い方:
#   bin/build-dict           通常実行 (上流またはレシピに変化があったときだけ再構築)
#   bin/build-dict --force   変化の有無にかかわらず再構築する

set -euo pipefail

# --- 設定 ---------------------------------------------------------------

PREFIX="$(brew --prefix)"
VAR="$PREFIX/var/yaskkserv2"
SRC="$VAR/sources"                       # 上流クローンのキャッシュ (このスクリプトが管理)
DICT="$VAR/dictionary.yaskkserv2"        # yaskkserv2 が読む辞書 (出力)
LOCK="$VAR/.build-dict.lock"
RECIPE_STAMP="$VAR/.recipe.sha"          # 前回ビルドに使ったレシピの指紋 (このスクリプトが管理)
IDLE_THRESHOLD_SEC="${YASKK_BUILD_IDLE_THRESHOLD_SEC:-60}"
CHECK_STAMP="$VAR/.last-check"           # 最後に上流を確認し終えた時刻 (このスクリプトが管理)
CHECK_INTERVAL_SEC="${YASKK_BUILD_CHECK_INTERVAL_SEC:-72000}"   # 20 時間。日ごとの起動時刻のずれを吸収する

# macSKK 向けの辞書。macSKK は yaskkserv2 の辞書形式を読めないので、同じ内容を SKK-JISYO 形式
# (UTF-8) で書き出し、macSKK の辞書フォルダへコピーする。macSKK は辞書フォルダの変更を NSFilePresenter で
# 受け取り、ファイルが差し替わると自分で読み直す。ファイル名に "utf8" を含めると、macSKK は
# 辞書を追加したときに文字コードを UTF-8 と判定する。
MACSKK_JISYO_NAME="SKK-JISYO.yaskkserv2.utf8"
MACSKK_JISYO="$VAR/$MACSKK_JISYO_NAME"            # 書き出した辞書 (このスクリプトが生成)
MACSKK_EXPORT_STAMP="$VAR/.macskk-export.sha"     # 最後に macSKK へコピーした辞書の指紋
MACSKK_DICT_DIR="$HOME/Library/Containers/net.mtgto.inputmethod.macSKK/Data/Documents/Dictionaries"
MACSKK_TIMEOUT_SEC="${YASKK_BUILD_MACSKK_TIMEOUT_SEC:-30}"

JAWIKI_URL="https://github.com/tokuhirom/jawiki-kana-kanji-dict/releases/latest/download/SKK-JISYO.jawiki"
JAWIKI_FILE="$SRC/SKK-JISYO.jawiki"
JAWIKI_ETAG="$SRC/.jawiki.etag"

# 四角号碼の辞書は Wiktionary の辞書に Unihan と trimeSJHM を重ねて合成する (bin/make-shikakugoma)。
UNIHAN_URL="https://www.unicode.org/Public/UCD/latest/ucd/Unihan.zip"
UNIHAN_FILE="$SRC/Unihan.zip"
UNIHAN_ETAG="$SRC/.unihan.etag"
SHIKAKUGOMA="$SRC/generated/SKK-JISYO.shikakugoma"   # 合成した辞書 (このスクリプトが生成)

# git ソース: "ローカルディレクトリ名|clone URL"
GIT_SOURCES=(
    "dict|https://github.com/skk-dev/dict"
    "emoji|https://github.com/uasi/skk-emoji-jisyo"
    "emoji-ja|https://github.com/ymrl/SKK-JISYO.emoji-ja"
    "wiktionary|https://github.com/KeenS/SKK_JISYO.wiktionary"
    "trimeSJHM|https://github.com/happyDom/trimeSJHM"
)

# ビルド対象ファイル ($SRC からの相対パス)。
#
# 【順序が候補の表示順を決める】yaskkserv2_make_dictionary は同じ見出しの候補を
# 「与えたファイル順」に連結して重複排除する (先に出たファイルの候補が前に来る)。
# そのため一般的・頻用の辞書を前に、稀用漢字・絵文字などマイナーな辞書を後ろに置く。
# 逆にすると (例: JIS3_4 を L より前に置くと)「わらi」で稀用漢字の「咍/嘻/辴」が
# 「笑」より先に出るといった、マイナー候補が先頭に来る問題が起きる。
JISYO_FILES=(
    # --- 基本・一般語彙 (最優先) ---
    "dict/SKK-JISYO.L"
    # --- 人名・固有名詞 ---
    "dict/SKK-JISYO.jinmei"
    "dict/SKK-JISYO.fullname"
    "dict/SKK-JISYO.propernoun"
    # --- 地名・駅名など ---
    "dict/SKK-JISYO.geo"
    "dict/SKK-JISYO.station"
    "dict/SKK-JISYO.law"
    "dict/SKK-JISYO.okinawa"
    "dict/SKK-JISYO.china_taiwan"
    "dict/SKK-JISYO.assoc"
    "dict/SKK-JISYO.mazegaki"
    "dict/zipcode/SKK-JISYO.office.zipcode"
    "dict/zipcode/SKK-JISYO.zipcode"
    # --- Web 由来 (大量・ノイズ多め) ---
    "SKK-JISYO.jawiki"
    "dict/SKK-JISYO.edict"
    # --- 稀用漢字・異体字 (マイナー) ---
    "dict/SKK-JISYO.JIS2"
    "dict/SKK-JISYO.JIS3_4"
    "dict/SKK-JISYO.JIS2004"
    "dict/SKK-JISYO.itaiji"
    "dict/SKK-JISYO.itaiji.JIS3_4"
    # 四角号碼 (Wiktionary の辞書に Unihan と trimeSJHM を重ねたもの。下の「合成」で作る)
    "generated/SKK-JISYO.shikakugoma"
    # --- 絵文字 (末尾) ---
    "emoji-ja/SKK-JISYO.emoji-ja.utf8"
    "emoji/SKK-JISYO.emoji.utf8"
)

# --- ユーティリティ -----------------------------------------------------

log() { printf '%s %s\n' "$(/bin/date -Iseconds)" "$*" >&2; }
die() { log "ERROR: $*"; exit 1; }

# --- macSKK への書き出し -------------------------------------------------
#
# macSKK の辞書フォルダは他のアプリのサンドボックスの中なので、読み書きには TCC の許可が要る。
# 許可は launchd ジョブの「責任プロセス」に対して記録されるため、plist は /bin/bash でこの
# スクリプトを起動する (skk-jisyo の skk-sync と同じ。/bin/bash にフルディスクアクセスを与える)。
#
# 応答されない TCC のプロンプトは syscall を無期限に止めるので、辞書フォルダに触るコマンドは
# macskk_run で時間を区切る。触るのは Apple 署名の /bin/cp と /bin/mv だけにする (コマンドごとに
# 許可のプロンプトが出るのを避けるため)。

# macskk_run コマンド... — $MACSKK_TIMEOUT_SEC を超えたら kill して 124 を返す
macskk_run() {
    local pid i=0
    "$@" &
    pid=$!
    while (( i < MACSKK_TIMEOUT_SEC * 10 )); do
        kill -0 "$pid" 2>/dev/null || break
        /bin/sleep 0.1
        i=$((i + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
        return 124
    fi
    wait "$pid"
}

# yaskkserv2 の辞書から macSKK 向けの SKK-JISYO を書き出す。--utf8 を付けないと
# EUC-JIS-2004 で書き出され、絵文字など EUC に無い文字が落ちる。
write_macskk_jisyo() {
    local tmp
    tmp="$(mktemp "$VAR/.macskk-jisyo.XXXXXX")"
    if ! yaskkserv2_make_dictionary --utf8 --dictionary-filename="$DICT" \
            --output-jisyo-filename="$tmp" >/dev/null; then
        rm -f "$tmp"
        log "WARN: failed to write $MACSKK_JISYO_NAME"
        return 1
    fi
    if [[ ! -s "$tmp" ]]; then
        rm -f "$tmp"
        log "WARN: written $MACSKK_JISYO_NAME is empty"
        return 1
    fi
    chmod 644 "$tmp"
    mv -f "$tmp" "$MACSKK_JISYO"
    log "wrote: $MACSKK_JISYO ($(wc -c <"$MACSKK_JISYO" | tr -d ' ') bytes)"
}

# 書き出した辞書を macSKK の辞書フォルダへコピーする。前回コピーしたものと同じなら何もしない。
# 一時ファイルは "." で始まる名前にする — macSKK は隠しファイルを辞書として扱わないので、
# コピーの途中のファイルを拾われない。同じフォルダの中で mv するので差し替えは一度で済む。
export_to_macskk() {
    [[ -f "$MACSKK_JISYO" ]] || write_macskk_jisyo || return 0
    if [[ ! -d "$MACSKK_DICT_DIR" ]]; then
        # ディレクトリの有無は stat だけで分かり、TCC の許可は要らない
        return 0   # macSKK を入れていない Mac
    fi
    local sha
    sha="$(shasum -a 256 "$MACSKK_JISYO" | awk '{print $1}')"
    if [[ "$sha" == "$(cat "$MACSKK_EXPORT_STAMP" 2>/dev/null || true)" ]]; then
        return 0
    fi
    local tmp="$MACSKK_DICT_DIR/.$MACSKK_JISYO_NAME.tmp"
    if macskk_run /bin/cp "$MACSKK_JISYO" "$tmp" 2>/dev/null \
            && macskk_run /bin/mv -f "$tmp" "$MACSKK_DICT_DIR/$MACSKK_JISYO_NAME" 2>/dev/null; then
        printf '%s\n' "$sha" > "$MACSKK_EXPORT_STAMP"
        log "exported to macSKK: $MACSKK_DICT_DIR/$MACSKK_JISYO_NAME"
    else
        log "WARN: cannot write to macSKK dictionary dir (TCC not granted to /bin/bash, or timed out); will retry next run"
    fi
}

# ビルドレシピ = このスクリプト自身 + normalizer + 四角号碼の合成スクリプト。辞書の並び順や
# 正規化ロジックなど、出力に影響する「作り方」の指紋を取る。上流データが変わらなくてもレシピが変われば
# 再ビルドさせるために使う (変化判定で参照)。
SELF="${BASH_SOURCE[0]}"
NORMALIZER="$(dirname "$SELF")/normalize-jisyo"
SHIKAKUGOMA_MAKER="$(dirname "$SELF")/make-shikakugoma"
recipe_hash() { cat "$SELF" "$NORMALIZER" "$SHIKAKUGOMA_MAKER" | shasum -a 256 | awk '{print $1}'; }

FORCE=0
[[ "${1:-}" == "--force" ]] && FORCE=1

CHANGED=0   # いずれかの上流が更新されたら 1

# --- 単一インスタンスロック ---------------------------------------------

mkdir -p "$VAR" "$SRC"
if ! mkdir "$LOCK" 2>/dev/null; then
    log "another instance is running (lock: $LOCK); exiting"
    exit 0
fi
trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT

# --- 確認の間引き (--force 時はスキップ) ---------------------------------
# 1 時間ごとに起動されるが、上流の確認は $CHECK_INTERVAL_SEC に 1 回でよい。ここでは
# ログを出さない (毎時のログで埋まるのを避ける)。レシピが変わったときは間引かない。

if (( ! FORCE )) && [[ -f "$CHECK_STAMP" ]] \
        && [[ "$(recipe_hash)" == "$(cat "$RECIPE_STAMP" 2>/dev/null || true)" ]]; then
    last_check="$(cat "$CHECK_STAMP" 2>/dev/null || echo 0)"
    if (( $(/bin/date +%s) - ${last_check:-0} < CHECK_INTERVAL_SEC )); then
        exit 0
    fi
fi

# --- アイドルチェック (--force 時はスキップ) -----------------------------
# 入力中にサービスを再起動して取りこぼすのを避ける。再起動は「変化時のみ」なので緩め。

if (( ! FORCE )) && (( IDLE_THRESHOLD_SEC > 0 )); then
    ioreg_out=$(/usr/sbin/ioreg -c IOHIDSystem)
    idle_ns=$(printf '%s\n' "$ioreg_out" | /usr/bin/awk '/HIDIdleTime/ {print $NF; exit}')
    idle_sec=$(( ${idle_ns:-0} / 1000000000 ))
    if (( idle_sec < IDLE_THRESHOLD_SEC )); then
        log "active (idle=${idle_sec}s < ${IDLE_THRESHOLD_SEC}s); skipping"
        exit 0
    fi
fi

# --- 必須コマンド -------------------------------------------------------

command -v yaskkserv2_make_dictionary >/dev/null || die "yaskkserv2_make_dictionary not found in PATH"
command -v git >/dev/null || die "git not found in PATH"
command -v curl >/dev/null || die "curl not found in PATH"
command -v python3 >/dev/null || die "python3 not found in PATH"
command -v shasum >/dev/null || die "shasum not found in PATH"

# --- git ソースの更新 ---------------------------------------------------

update_git() {
    local name="$1" url="$2"
    local dir="$SRC/$name"
    if [[ -d "$dir/.git" ]]; then
        local before after branch
        before=$(git -C "$dir" rev-parse HEAD 2>/dev/null || echo none)
        branch=$(git -C "$dir" symbolic-ref --short HEAD 2>/dev/null || echo master)
        if git -C "$dir" fetch --depth 1 --quiet origin "$branch" 2>/dev/null; then
            git -C "$dir" reset --hard --quiet FETCH_HEAD
            after=$(git -C "$dir" rev-parse HEAD)
            if [[ "$before" != "$after" ]]; then
                CHANGED=1
                log "updated: $name ($before -> $after)"
            fi
        else
            log "WARN: fetch failed for $name; using existing checkout"
        fi
    else
        rm -rf "$dir"
        log "cloning: $name from $url"
        git clone --depth 1 --quiet "$url" "$dir" || die "clone failed: $url"
        CHANGED=1
    fi
}

for entry in "${GIT_SOURCES[@]}"; do
    update_git "${entry%%|*}" "${entry#*|}"
done

# --- 単一ファイルの取得 (ETag 条件付き取得) ------------------------------

# update_download 表示名 URL 保存先 ETAG保存先
update_download() {
    local name="$1" url="$2" file="$3" etag="$4"
    # ファイルが無いのに etag だけ残っていると 304 で取り損ねるので、その場合は etag を捨てる。
    [[ -f "$file" ]] || rm -f "$etag"
    local tmp
    tmp="$(mktemp)"
    if curl -fsSL --etag-compare "$etag" --etag-save "$etag" -o "$tmp" "$url"; then
        if [[ -s "$tmp" ]]; then
            # GitHub Releases のリダイレクト先は ETag 条件付き GET を尊重しないことがあるため、
            # 本文が返っても中身が同じなら無駄な再ビルドを避ける。
            if [[ -f "$file" ]] && cmp -s "$tmp" "$file"; then
                rm -f "$tmp"
            else
                mv -f "$tmp" "$file"
                CHANGED=1
                log "updated: $name ($(wc -c <"$file" | tr -d ' ') bytes)"
            fi
        else
            rm -f "$tmp"   # 304 Not Modified
        fi
    else
        rm -f "$tmp"
        log "WARN: $name download failed; using existing copy if present"
    fi
}

update_download "SKK-JISYO.jawiki" "$JAWIKI_URL" "$JAWIKI_FILE" "$JAWIKI_ETAG"
update_download "Unihan.zip" "$UNIHAN_URL" "$UNIHAN_FILE" "$UNIHAN_ETAG"

# --- 変化判定 -----------------------------------------------------------

[[ -f "$DICT" ]] || CHANGED=1   # 出力が無ければ必ずビルド
if (( FORCE )); then
    CHANGED=1
fi

# レシピ (build-dict / normalize-jisyo) が変わったら、上流に変化が無くても再ビルドする。
# 反映済みの指紋はビルド成功後に $RECIPE_STAMP へ保存する (原子的差し替えの後)。
recipe_now="$(recipe_hash)"
if [[ "$recipe_now" != "$(cat "$RECIPE_STAMP" 2>/dev/null || true)" ]]; then
    CHANGED=1
    log "recipe changed; rebuild"
fi

if (( ! CHANGED )); then
    log "no upstream change; skip rebuild"
    export_to_macskk   # 前回コピーできなかった (TCC の許可が無かった等) ときのやり直し
    /bin/date +%s > "$CHECK_STAMP"
    exit 0
fi

# --- 四角号碼の辞書の合成 -----------------------------------------------

# 上流 (KeenS/SKK_JISYO.wiktionary) はリポジトリ名こそ SKK_JISYO だが、中の辞書ファイルは
# SKK-JISYO 始まり。2026-09-25 の更新で SKK_JISYO.* から改名されたので、ハイフンのほうを見る。
[[ -f "$UNIHAN_FILE" ]] || die "Unihan.zip missing: $UNIHAN_FILE"
mkdir -p "$(dirname "$SHIKAKUGOMA")"
python3 "$SHIKAKUGOMA_MAKER" \
    "$SRC/wiktionary/SKK-JISYO.shikakugoma" "$UNIHAN_FILE" "$SRC/trimeSJHM/sjhm_base.dict.yaml" \
    "$SHIKAKUGOMA.tmp" || die "make-shikakugoma failed"
mv -f "$SHIKAKUGOMA.tmp" "$SHIKAKUGOMA"

# --- ビルド対象の存在確認 -----------------------------------------------

build_args=()
for rel in "${JISYO_FILES[@]}"; do
    f="$SRC/$rel"
    [[ -f "$f" ]] || die "expected jisyo missing: $f"
    build_args+=("$f")
done

# --- 一時ファイルにビルド → 原子的差し替え ------------------------------

tmp_dict="$(mktemp "$VAR/.dictionary.XXXXXX")"
norm_dir="$(mktemp -d "$VAR/.normalized.XXXXXX")"
# yaskkserv2_make_dictionary は cache を出力辞書名 + ".cache" にも作るので一緒に掃除する
cleanup_tmp() { rm -f "$tmp_dict" "$tmp_dict.cache"; rm -rf "$norm_dir"; }
trap 'cleanup_tmp; rmdir "$LOCK" 2>/dev/null || true' EXIT

# 見出しの "う゛" を "ゔ" に正規化 (UTF-8化) してからビルドする。EUC辞書 (SKK-JISYO.L等,
# ヴ音を "う゛" で登録) と UTF-8辞書 (jawiki等, "ゔ" ネイティブ) の見出しを揃えるため。
# 正規化コピーを元と同じ順序で make_dictionary に渡す。
normalizer="$NORMALIZER"
norm_args=()
for idx in "${!build_args[@]}"; do
    nf="$norm_dir/$idx.jisyo"
    python3 "$normalizer" "${build_args[$idx]}" "$nf" || die "normalize failed: ${build_args[$idx]}"
    norm_args+=("$nf")
done

log "building dictionary (${#norm_args[@]} jisyo files)"
if ! yaskkserv2_make_dictionary --utf8 --dictionary-filename="$tmp_dict" "${norm_args[@]}"; then
    die "yaskkserv2_make_dictionary failed; existing dictionary left intact"
fi
[[ -s "$tmp_dict" ]] || die "built dictionary is empty; aborting"

mv -f "$tmp_dict" "$DICT"
printf '%s\n' "$recipe_now" > "$RECIPE_STAMP"   # このレシピで作った証跡 (次回の変化判定に使う)
log "installed: $DICT ($(wc -c <"$DICT" | tr -d ' ') bytes)"

# --- サービス再起動 -----------------------------------------------------
# 原子的 mv では稼働中プロセスは古い inode を掴んだままなので、必ずプロセスを
# 入れ替える必要がある。launchd 管理サービスには kickstart -k が確実
# (brew services restart は state 不整合時に no-op になることがある)。

listener_pid() { lsof -nP -iTCP:1178 -sTCP:LISTEN -t 2>/dev/null | head -1 || true; }

# brew services が使う launchd ラベルは Homebrew のバージョンで変わる
# (古い brew は homebrew.mxcl.yaskkserv2、新しい brew は sh.brew.yaskkserv2)。
# 決め打ちせず実際の状態を見て決める。詳細は bin/yaskkserv2-watchdog の detect_label 参照。
detect_label() {
    local label
    label="$(launchctl list 2>/dev/null | awk '$3 ~ /(^|\.)yaskkserv2$/ { print $3; exit }')"
    if [[ -n "$label" ]]; then
        printf '%s\n' "$label"
        return
    fi
    brew services info yaskkserv2 --json 2>/dev/null \
        | sed -n 's/.*"service_name" *: *"\([^"]*\)".*/\1/p' \
        | head -1
}

restart_service() {
    local label domain before after
    label="$(detect_label)"
    domain="gui/$(id -u)"
    before="$(listener_pid)"

    { [[ -n "$label" ]] && launchctl kickstart -k "$domain/$label" >/dev/null 2>&1; } \
        || brew services restart yaskkserv2 >/dev/null 2>&1 || true
    sleep 2
    after="$(listener_pid)"

    if [[ -n "$after" && "$after" != "$before" ]]; then
        log "restarted yaskkserv2 (pid ${before:-none} -> $after)"
        return
    fi

    # リスナー PID が変わっていない = 古い inode を掴んだまま、もしくは launchd 管理外の
    # プロセスがポートを専有して新インスタンスが bind できていない。ポート専有プロセスを
    # 落として keepalive に再生成させる (1178 を握っている当該 PID のみを対象)。
    if [[ -n "$before" ]]; then
        log "stale listener pid $before still bound; killing to force reload"
        kill "$before" 2>/dev/null || true
        sleep 1
        { [[ -n "$label" ]] && launchctl kickstart "$domain/$label" >/dev/null 2>&1; } \
            || brew services start yaskkserv2 >/dev/null 2>&1 || true
        sleep 2
        after="$(listener_pid)"
    fi

    if [[ -n "$after" ]]; then
        log "yaskkserv2 listening (pid $after)"
    else
        log "WARN: yaskkserv2 not listening after restart; check manually"
    fi
}
restart_service

# --- macSKK への書き出し -------------------------------------------------
# 失敗しても yaskkserv2 の辞書の更新は済んでいるので、ビルドは失敗にしない。
write_macskk_jisyo && export_to_macskk

/bin/date +%s > "$CHECK_STAMP"
log "build ok"
