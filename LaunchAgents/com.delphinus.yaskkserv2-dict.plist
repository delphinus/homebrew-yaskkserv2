<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.delphinus.yaskkserv2-dict</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jinnouchi.yasushi/git/github.com/delphinus/homebrew-yaskkserv2/bin/build-dict</string>
    </array>

    <!-- 1 時間ごと。上流の確認は build-dict が 1 日 1 回に間引く。定時 (StartCalendarInterval)
         にすると、毎晩電源を切る Mac では一度も起動しない。再構築は上流に変化があったときだけ。 -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/jinnouchi.yasushi</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/jinnouchi.yasushi/Library/Logs/yaskkserv2-dict.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/jinnouchi.yasushi/Library/Logs/yaskkserv2-dict.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>

    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
